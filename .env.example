# Optional Compose overrides when running from this directory
# (e.g. cd GeoAPI && docker compose up). Copy to .env in this directory.

# API service image is ialsina/geoapi:${IMAGE_TAG} (see docker-compose.yml).
IMAGE_TAG=latest

# When true, the API container downloads datasets and populates PostGIS on first boot.
AUTO_POPULATE_DATA=true
# One-shot refresh: set true, recreate api, then return to false.
FORCE_POPULATE=false
