# GitLab Container Registry. Used when running docker compose from this directory
# (e.g. cd GeoAPI && docker compose up --build). In GitLab CI, CI_REGISTRY_IMAGE is set automatically.
# Copy to .env in this directory.

REGISTRY_IMAGE=registry.gitlab.com/your-namespace/geoapi
IMAGE_TAG=latest

# When true, the API container downloads datasets and populates PostGIS on first boot.
AUTO_POPULATE_DATA=true
# One-shot refresh: set true, recreate api, then return to false.
FORCE_POPULATE=false
